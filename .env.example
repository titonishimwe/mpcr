SECRET_KEY=replace-with-a-secure-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,mouvementpourchriste.org,www.mouvementpourchriste.org
CSRF_TRUSTED_ORIGINS=https://mouvementpourchriste.org,https://www.mouvementpourchriste.org

# Default application administrator
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=info@mouvementpourchriste.org
DEFAULT_ADMIN_PASSWORD=change-this-password

# Database Configuration (Defaults to SQLite; uncomment for PostgreSQL)
# DB_ENGINE=postgresql
# DB_NAME=mpcr_db
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432

# Email (required for password reset / account email change in production)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=info@mouvementpourchriste.org

# Optional HTTPS hardening behind a reverse proxy
# SECURE_SSL_REDIRECT=True
# ENABLE_HSTS=True
